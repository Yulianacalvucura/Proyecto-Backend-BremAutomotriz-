POSTGRES_PASSWORD=<contraseña_postgres>
DB_PASSWORD_USUARIOS=<contraseña_usuarios>
DB_PASSWORD_TALLER=<contraseña_taller>
JWT_SECRET=<secreto_de_al_menos_32_caracteres>

# Orígenes CORS permitidos (separados por coma). Sin definir, mantiene el comportamiento local.
# En producción con EIP: CORS_ORIGINS=http://IP_ELASTICA:3000
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# URL pública que aparece en Swagger (apunta al gateway).
# En producción con EIP: APP_PUBLIC_URL=http://IP_ELASTICA:9090
APP_PUBLIC_URL=http://localhost:9090
