# Copia este archivo como .env y ajusta los valores antes de "docker compose up".
# ADVERTENCIA: el .env real NO se versiona (esta en .gitignore).

POSTGRES_PASSWORD=<contraseña_postgres>
DB_PASSWORD_USUARIOS=<contraseña_usuarios>
DB_PASSWORD_TALLER=<contraseña_taller>
JWT_SECRET=<secreto_de_al_menos_32_caracteres>
